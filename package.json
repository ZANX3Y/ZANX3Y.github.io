{
  "name": "zanxey",
  "version": "4.0.1",
  "engines": {
    "bun": "^1.3.0"
  },
  "scripts": {
    "build": "bun run clean && bun run copy:all && bun run sass",
    "sass": "sass src/sass:dist/assets/css --no-source-map --style=compressed",
    "copy:all": "cp src/*.html dist/ && cp -r src/assets dist/assets",
    "clean": "rm -rf dist && mkdir dist",
    "dev": "bun run build && concurrently --kill-others-on-fail \"bun run sass:watch\" \"bun run copy:watch\" \"bun run serve\"",
    "sass:watch": "sass --watch src/sass:dist/assets/css --no-source-map",
    "copy:watch": "chokidar 'src/**/*.{html,js,png,jpg,jpeg,svg,ico}' -i 'dist/**' -c \"bun scripts/copy-changed.js {path} {event}\"",
    "serve": "serve dist -s -p 2137"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "sass": "^1.90.0",
    "serve": "^14.2.6"
  }
}
